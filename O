end)

RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    -- แสดง/ซ่อน วงกลมระบุระยะทาง
    if hrp and Config.ShowBlockRange and Config.AutoBlock then
        CirclePart.Parent = workspace
        CirclePart.Size = Vector3.new(0.2, Config.BlockDistance * 2, Config.BlockDistance * 2)
        CirclePart.CFrame = hrp.CFrame * CFrame.Angles(0, 0, math.rad(90)) + Vector3.new(0, -2.5, 0)
    else
        CirclePart.Parent = nil
    end

    if not Config.AutoBlock or not hrp then return end

    for _, obj in pairs(workspace:GetChildren()) do
        if obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") and obj ~= char then
            local dist = (hrp.Position - obj.HumanoidRootPart.Position).Magnitude
            if dist <= Config.BlockDistance then
                keypress(0x46)
                task.wait(0.05)
                keyrelease(0x46)
            end
        end
    end
end)

